<Window x:Class="Nova.UI.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Nova.UI"
        xmlns:robot="clr-namespace:Nova.UI.Robot"
        mc:Ignorable="d"
        Title="NOVA Dynamic Island"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="460"
        Height="250"
        MouseMove="Window_MouseMove"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseRightButtonUp="Window_MouseRightButtonUp"
        Loaded="Window_Loaded"
        Closed="Window_Closed">

    <Window.Resources>
        <!-- Dark sleek button style -->
        <Style x:Key="IslandActionButton" TargetType="Button">
            <Setter Property="Background" Value="#1B202C"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#2D3748"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="7,3"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="5" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A3346"/>
                    <Setter Property="BorderBrush" Value="#38BDF8"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#151A24"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Icon button style -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#232B3E"/>
                    <Setter Property="Foreground" Value="#38BDF8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Sleek Dark Context Menu -->
        <ContextMenu x:Key="IslandContextMenu" Background="#11151F" BorderBrush="#252C3B" BorderThickness="1">
            <ContextMenu.Resources>
                <Style TargetType="MenuItem">
                    <Setter Property="Foreground" Value="#E2E8F0"/>
                    <Setter Property="Background" Value="#11151F"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Padding" Value="10,6"/>
                </Style>
                <Style TargetType="Separator">
                    <Setter Property="Background" Value="#252C3B"/>
                    <Setter Property="Margin" Value="4,2"/>
                </Style>
            </ContextMenu.Resources>
            <MenuItem Header="Expand / Dashboard" Click="MenuExpand_Click" FontWeight="SemiBold"/>
            <MenuItem Header="Compact Pill" Click="MenuCompact_Click"/>
            <MenuItem Header="Reset Position (Top Center)" Click="MenuResetPosition_Click"/>
            <MenuItem x:Name="MenuAlwaysOnTop" Header="Always On Top" IsCheckable="True" IsChecked="True" Click="MenuAlwaysOnTop_Click"/>
            <Separator/>
            <MenuItem Header="Robot Companion">
                <MenuItem Header="Test: ✨ Excited" Click="MenuTestExcited_Click"/>
                <MenuItem Header="Test: ❓ Confused" Click="MenuTestConfused_Click"/>
                <MenuItem Header="Test: 👋 Nod" Click="MenuTestNod_Click"/>
                <Separator/>
                <MenuItem Header="Personality: Calm" Click="MenuPersonalityCalm_Click"/>
                <MenuItem Header="Personality: Playful" Click="MenuPersonalityPlayful_Click"/>
                <MenuItem Header="Personality: Minimal" Click="MenuPersonalityMinimal_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuBatterySaver" Header="Battery Saver Mode" IsCheckable="True" Click="MenuBatterySaver_Click"/>
                <MenuItem x:Name="MenuReducedMotion" Header="Reduced Motion" IsCheckable="True" Click="MenuReducedMotion_Click"/>
            </MenuItem>
            <Separator/>
            <MenuItem Header="Hide to Tray" Click="MenuHide_Click"/>
            <MenuItem Header="Exit NOVA" Click="MenuExit_Click"/>
        </ContextMenu>
    </Window.Resources>

    <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Margin="10">
        <!-- Main Island Pill Border -->
        <Border x:Name="PillBorder"
                Width="210"
                Height="42"
                CornerRadius="21"
                Background="#0D1117"
                BorderBrush="#252C3B"
                BorderThickness="1"
                ClipToBounds="True"
                Cursor="Hand"
                MouseLeftButtonDown="Pill_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.55"/>
            </Border.Effect>

            <Grid>
                <!-- COMPACT STATE VIEW -->
                <Grid x:Name="CompactPanel" Height="42" VerticalAlignment="Center" Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Robot Mascot Companion (Compact 26px) -->
                    <robot:RobotCompanion x:Name="CompactRobot" 
                                          CompanionSize="26" 
                                          Grid.Column="0" 
                                          VerticalAlignment="Center" 
                                          Margin="0,0,8,0"/>

                    <!-- Name & Status Badge -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="NOVA" 
                                   FontWeight="Bold" 
                                   FontSize="12" 
                                   Foreground="#F8FAFC" 
                                   VerticalAlignment="Center"/>
                        <Border Background="#1E293B" 
                                CornerRadius="4" 
                                Padding="5,1" 
                                Margin="6,0,0,0" 
                                VerticalAlignment="Center">
                            <TextBlock Text="READY" 
                                       FontSize="8" 
                                       FontWeight="Bold" 
                                       Foreground="#38BDF8"/>
                        </Border>
                    </StackPanel>

                    <!-- Time Indicator -->
                    <TextBlock x:Name="ClockText" 
                               Grid.Column="2" 
                               Text="12:00" 
                               FontSize="11" 
                               Foreground="#94A3B8" 
                               VerticalAlignment="Center" 
                               Margin="0,0,8,0"/>

                    <!-- Expand Chevron Button -->
                    <Button Grid.Column="3" 
                            Style="{StaticResource IconButton}" 
                            Content="▾" 
                            FontSize="12" 
                            ToolTip="Expand Island" 
                            Click="ExpandButton_Click"/>
                </Grid>

                <!-- EXPANDED STATE VIEW -->
                <Grid x:Name="ExpandedPanel" 
                      Opacity="0" 
                      Visibility="Collapsed" 
                      Margin="16,12,16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header Row -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Fill="#38BDF8" Margin="0,0,8,0"/>
                            <TextBlock Text="NOVA COMPANION" 
                                       FontWeight="Bold" 
                                       FontSize="12" 
                                       Foreground="#38BDF8" 
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="v0.1.0" 
                                       FontSize="10" 
                                       Foreground="#64748B" 
                                       Margin="8,0,0,0" 
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Header Controls -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource IconButton}" 
                                    x:Name="PinButton" 
                                    Content="📌" 
                                    FontSize="10" 
                                    ToolTip="Toggle Always On Top" 
                                    Click="PinButton_Click" 
                                    Margin="0,0,4,0"/>
                            <Button Style="{StaticResource IconButton}" 
                                    Content="—" 
                                    FontSize="11" 
                                    ToolTip="Hide to System Tray" 
                                    Click="HideButton_Click" 
                                    Margin="0,0,4,0"/>
                            <Button Style="{StaticResource IconButton}" 
                                    Content="▴" 
                                    FontSize="12" 
                                    ToolTip="Compact Pill" 
                                    Click="CompactButton_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Content Cards -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Card 1: Showcase Robot & Reaction Controls -->
                        <Border Grid.Column="0" 
                                Background="#141822" 
                                BorderBrush="#252D3D" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Showcase Robot (48px) -->
                                <robot:RobotCompanion x:Name="ExpandedRobot" 
                                                      CompanionSize="48" 
                                                      Grid.Column="0" 
                                                      VerticalAlignment="Center" 
                                                      Margin="0,0,10,0"/>

                                <!-- Reaction Test Buttons -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="RobotStatusText" 
                                               Text="COMPANION • ACTIVE" 
                                               FontSize="8.5" 
                                               FontWeight="Bold" 
                                               Foreground="#38BDF8" 
                                               Margin="0,0,0,2"/>
                                    <TextBlock x:Name="EventStatusText" 
                                               Text="BUS: READY • 0 EVENTS" 
                                               FontSize="8" 
                                               FontWeight="Medium" 
                                               Foreground="#94A3B8" 
                                               Margin="0,0,0,5"/>
                                    <WrapPanel>
                                        <Button Style="{StaticResource IslandActionButton}" 
                                                Content="✨ Happy" 
                                                Click="BtnExcited_Click" 
                                                Margin="0,0,4,4"/>
                                        <Button Style="{StaticResource IslandActionButton}" 
                                                Content="❓ Confused" 
                                                Click="BtnConfused_Click" 
                                                Margin="0,0,4,4"/>
                                        <Button Style="{StaticResource IslandActionButton}" 
                                                Content="👋 Nod" 
                                                Click="BtnNod_Click" 
                                                Margin="0,0,4,4"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Card 2: Quick Position & Monitor Control -->
                        <Border Grid.Column="2" 
                                Background="#141822" 
                                BorderBrush="#252D3D" 
                                BorderThickness="1" 
                                CornerRadius="8" 
                                Padding="10">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="POSITIONING" 
                                           FontSize="8.5" 
                                           FontWeight="Bold" 
                                           Foreground="#A855F7" 
                                           Margin="0,0,0,4"/>
                                <TextBlock x:Name="MonitorInfoText" 
                                           Text="Primary Monitor" 
                                           FontSize="10.5" 
                                           FontWeight="Medium" 
                                           Foreground="#E2E8F0" 
                                           Margin="0,0,0,6"/>
                                <Button Style="{StaticResource IslandActionButton}" 
                                        Content="Center to Top" 
                                        Click="MenuResetPosition_Click" 
                                        HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Footer Controls -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Move cursor to track • Click mascot to nod" 
                                   FontSize="9.5" 
                                   Foreground="#64748B" 
                                   VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource IslandActionButton}" 
                                    Content="Compact" 
                                    Click="CompactButton_Click" 
                                    Margin="0,0,6,0"/>
                            <Button Style="{StaticResource IslandActionButton}" 
                                    Content="Exit" 
                                    Click="MenuExit_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
