<UserControl x:Class="Nova.UI.Robot.RobotCompanion"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="64" d:DesignWidth="64">

    <Grid x:Name="RootContainer" Width="{Binding CompanionSize, RelativeSource={RelativeSource AncestorType=UserControl}}" 
          Height="{Binding CompanionSize, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <Viewbox Stretch="Uniform">
            <Canvas Width="64" Height="64">
                <!-- Master Head Transform (Float & Nod) -->
                <Grid x:Name="HeadContainer" Width="64" Height="64">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <TranslateTransform x:Name="HeadFloatTransform" X="0" Y="0"/>
                            <RotateTransform x:Name="HeadRotateTransform" Angle="0" CenterX="32" CenterY="32"/>
                        </TransformGroup>
                    </Grid.RenderTransform>

                    <!-- Left Ear / Antenna Node -->
                    <Path Data="M 10 24 C 6 24, 4 28, 4 33 C 4 38, 6 42, 10 42 Z" Fill="#CBD5E1"/>
                    <Ellipse Canvas.Left="5" Canvas.Top="28" Width="4" Height="4" Fill="#38BDF8" HorizontalAlignment="Left" Margin="4,30,0,0" VerticalAlignment="Top"/>

                    <!-- Right Ear / Antenna Node -->
                    <Path Data="M 54 24 C 58 24, 60 28, 60 33 C 60 38, 58 42, 54 42 Z" Fill="#CBD5E1"/>
                    <Ellipse Width="4" Height="4" Fill="#38BDF8" HorizontalAlignment="Right" Margin="0,30,4,0" VerticalAlignment="Top"/>

                    <!-- Antenna Top LED Pin -->
                    <Rectangle Width="2" Height="6" Fill="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0"/>
                    <Ellipse x:Name="AntennaLed" Width="5" Height="5" Fill="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0"/>

                    <!-- White/Silver Metallic Head Shell -->
                    <Border x:Name="HeadChassis" 
                            Width="46" Height="44" 
                            CornerRadius="16" 
                            BorderBrush="#CBD5E1" 
                            BorderThickness="1.5" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center" 
                            Margin="0,6,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                <GradientStop Color="#F1F5F9" Offset="0.6"/>
                                <GradientStop Color="#E2E8F0" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>

                        <!-- Visor Faceplate (Obsidian Gloss) -->
                        <Border x:Name="VisorPlate" 
                                Width="36" Height="26" 
                                CornerRadius="10" 
                                Background="#0A0D14" 
                                BorderBrush="#1E293B" 
                                BorderThickness="1" 
                                HorizontalAlignment="Center" 
                                VerticalAlignment="Center">

                            <!-- Eye Gaze Tracking Container -->
                            <Grid x:Name="EyesGazeContainer" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid.RenderTransform>
                                    <TranslateTransform x:Name="GazeTransform" X="0" Y="0"/>
                                </Grid.RenderTransform>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- Left Eye -->
                                    <Grid Width="10" Height="14" Margin="0,0,3,0">
                                        <Grid.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform x:Name="LeftEyeScale" ScaleX="1.0" ScaleY="1.0" CenterX="5" CenterY="7"/>
                                                <RotateTransform x:Name="LeftEyeRotate" Angle="0" CenterX="5" CenterY="7"/>
                                            </TransformGroup>
                                        </Grid.RenderTransform>

                                        <!-- Normal Open Eye -->
                                        <Border x:Name="LeftEyeNormal" 
                                                Width="7" Height="10" 
                                                CornerRadius="3.5" 
                                                Background="#38BDF8"/>

                                        <!-- Happy Arc Eye (Chevrons) -->
                                        <Path x:Name="LeftEyeHappy" 
                                              Data="M 1 8 Q 5 2 9 8" 
                                              Stroke="#38BDF8" 
                                              StrokeThickness="2.2" 
                                              StrokeStartLineCap="Round" 
                                              StrokeEndLineCap="Round" 
                                              Visibility="Collapsed"/>

                                        <!-- Sleeping Flat Eye -->
                                        <Rectangle x:Name="LeftEyeSleeping" 
                                                   Width="7" Height="2" 
                                                   RadiusX="1" RadiusY="1" 
                                                   Fill="#0284C7" 
                                                   Visibility="Collapsed"/>
                                    </Grid>

                                    <!-- Right Eye -->
                                    <Grid Width="10" Height="14" Margin="3,0,0,0">
                                        <Grid.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform x:Name="RightEyeScale" ScaleX="1.0" ScaleY="1.0" CenterX="5" CenterY="7"/>
                                                <RotateTransform x:Name="RightEyeRotate" Angle="0" CenterX="5" CenterY="7"/>
                                            </TransformGroup>
                                        </Grid.RenderTransform>

                                        <!-- Normal Open Eye -->
                                        <Border x:Name="RightEyeNormal" 
                                                Width="7" Height="10" 
                                                CornerRadius="3.5" 
                                                Background="#38BDF8"/>

                                        <!-- Happy Arc Eye (Chevrons) -->
                                        <Path x:Name="RightEyeHappy" 
                                              Data="M 1 8 Q 5 2 9 8" 
                                              Stroke="#38BDF8" 
                                              StrokeThickness="2.2" 
                                              StrokeStartLineCap="Round" 
                                              StrokeEndLineCap="Round" 
                                              Visibility="Collapsed"/>

                                        <!-- Sleeping Flat Eye -->
                                        <Rectangle x:Name="RightEyeSleeping" 
                                                   Width="7" Height="2" 
                                                   RadiusX="1" RadiusY="1" 
                                                   Fill="#0284C7" 
                                                   Visibility="Collapsed"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Border>
                </Grid>
            </Canvas>
        </Viewbox>
    </Grid>
</UserControl>

