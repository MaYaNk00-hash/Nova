<UserControl x:Class="Nova.UI.Robot.RobotCompanion"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="64" d:DesignWidth="64">

    <Grid x:Name="RootContainer" Width="{Binding CompanionSize, RelativeSource={RelativeSource AncestorType=UserControl}}" 
          Height="{Binding CompanionSize, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <Viewbox Stretch="Uniform">
            <Canvas Width="64" Height="64">
                <!-- Master Head Transform (Float & Nod) -->
                <Grid x:Name="HeadContainer" Width="64" Height="64">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <TranslateTransform x:Name="HeadFloatTransform" X="0" Y="0"/>
                            <RotateTransform x:Name="HeadRotateTransform" Angle="0" CenterX="32" CenterY="32"/>
                        </TransformGroup>
                    </Grid.RenderTransform>

                    <!-- Left Ear / Cyber Node -->
                    <Path Data="M 10 24 C 6 24, 4 28, 4 33 C 4 38, 6 42, 10 42 Z">
                        <Path.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                <GradientStop Color="#94A3B8" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Path.Fill>
                    </Path>
                    <Ellipse Canvas.Left="5" Canvas.Top="28" Width="4" Height="4" Fill="#00F2FE" HorizontalAlignment="Left" Margin="4,30,0,0" VerticalAlignment="Top">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#00F2FE" BlurRadius="5" ShadowDepth="0" Opacity="0.9"/>
                        </Ellipse.Effect>
                    </Ellipse>

                    <!-- Right Ear / Cyber Node -->
                    <Path Data="M 54 24 C 58 24, 60 28, 60 33 C 60 38, 58 42, 54 42 Z">
                        <Path.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                <GradientStop Color="#94A3B8" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Path.Fill>
                    </Path>
                    <Ellipse Width="4" Height="4" Fill="#00F2FE" HorizontalAlignment="Right" Margin="0,30,4,0" VerticalAlignment="Top">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#00F2FE" BlurRadius="5" ShadowDepth="0" Opacity="0.9"/>
                        </Ellipse.Effect>
                    </Ellipse>

                    <!-- Antenna Top LED Pin -->
                    <Rectangle Width="2" Height="6" Fill="#CBD5E1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0"/>
                    <Ellipse x:Name="AntennaLed" Width="5" Height="5" Fill="#00F2FE" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#00F2FE" BlurRadius="6" ShadowDepth="0" Opacity="0.95"/>
                        </Ellipse.Effect>
                    </Ellipse>

                    <!-- Shiny Metallic Head Shell with Specular Gloss (Noticeable & Crisp) -->
                    <Border x:Name="HeadChassis" 
                            Width="50" Height="46" 
                            CornerRadius="17" 
                            BorderThickness="1.5" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center" 
                            Margin="0,5,0,0">
                        <Border.BorderBrush>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                <GradientStop Color="#38BDF8" Offset="0.35"/>
                                <GradientStop Color="#64748B" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.BorderBrush>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0.8,1">
                                <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                <GradientStop Color="#F8FAFC" Offset="0.2"/>
                                <GradientStop Color="#E2E8F0" Offset="0.55"/>
                                <GradientStop Color="#CBD5E1" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.3"/>
                        </Border.Effect>

                        <!-- Visor Faceplate (Obsidian Gloss - Enlarged for Maximum Eye Visibility) -->
                        <Border x:Name="VisorPlate" 
                                Width="42" Height="30" 
                                CornerRadius="12" 
                                BorderThickness="1" 
                                HorizontalAlignment="Center" 
                                VerticalAlignment="Center"
                                ClipToBounds="True">
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#38BDF8" Offset="0.0"/>
                                    <GradientStop Color="#0F172A" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#141B2B" Offset="0.0"/>
                                    <GradientStop Color="#060910" Offset="0.6"/>
                                    <GradientStop Color="#030508" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>

                            <Grid>
                                <!-- Visor Top Gloss Reflection -->
                                <Border Height="9" VerticalAlignment="Top" CornerRadius="11,11,0,0" Opacity="0.2" IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                            <GradientStop Color="#38BDF8" Offset="0.35"/>
                                            <GradientStop Color="#00000000" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <!-- Eye Gaze Tracking Container -->
                                <Grid x:Name="EyesGazeContainer" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Grid.RenderTransform>
                                        <TranslateTransform x:Name="GazeTransform" X="0" Y="0"/>
                                    </Grid.RenderTransform>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- Left Eye (Big & Noticeable) -->
                                        <Grid Width="13" Height="17" Margin="0,0,3.5,0">
                                            <Grid.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform x:Name="LeftEyeScale" ScaleX="1.0" ScaleY="1.0" CenterX="6.5" CenterY="8.5"/>
                                                    <RotateTransform x:Name="LeftEyeRotate" Angle="0" CenterX="6.5" CenterY="8.5"/>
                                                </TransformGroup>
                                            </Grid.RenderTransform>

                                            <!-- Normal Open Eye (Luminous Cyan Neon) -->
                                            <Border x:Name="LeftEyeNormal" 
                                                    Width="9.5" Height="13.5" 
                                                    CornerRadius="4.75" 
                                                    Background="#00F2FE">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#00F2FE" BlurRadius="8" ShadowDepth="0" Opacity="0.95"/>
                                                </Border.Effect>
                                            </Border>

                                            <!-- Happy Arc Eye (Chevrons) -->
                                            <Path x:Name="LeftEyeHappy" 
                                                  Data="M 1 11 Q 6.5 3 12 11" 
                                                  Stroke="#00F2FE" 
                                                  StrokeThickness="2.8" 
                                                  StrokeStartLineCap="Round" 
                                                  StrokeEndLineCap="Round" 
                                                  Visibility="Collapsed">
                                                <Path.Effect>
                                                    <DropShadowEffect Color="#00F2FE" BlurRadius="8" ShadowDepth="0" Opacity="0.95"/>
                                                </Path.Effect>
                                            </Path>

                                            <!-- Sleeping Flat Eye -->
                                            <Rectangle x:Name="LeftEyeSleeping" 
                                                       Width="9.5" Height="3" 
                                                       RadiusX="1.5" RadiusY="1.5" 
                                                       Fill="#0284C7" 
                                                       Visibility="Collapsed"/>
                                        </Grid>

                                        <!-- Right Eye (Big & Noticeable) -->
                                        <Grid Width="13" Height="17" Margin="3.5,0,0,0">
                                            <Grid.RenderTransform>
                                                <TransformGroup>
                                                    <ScaleTransform x:Name="RightEyeScale" ScaleX="1.0" ScaleY="1.0" CenterX="6.5" CenterY="8.5"/>
                                                    <RotateTransform x:Name="RightEyeRotate" Angle="0" CenterX="6.5" CenterY="8.5"/>
                                                </TransformGroup>
                                            </Grid.RenderTransform>

                                            <!-- Normal Open Eye (Luminous Cyan Neon) -->
                                            <Border x:Name="RightEyeNormal" 
                                                    Width="9.5" Height="13.5" 
                                                    CornerRadius="4.75" 
                                                    Background="#00F2FE">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#00F2FE" BlurRadius="8" ShadowDepth="0" Opacity="0.95"/>
                                                </Border.Effect>
                                            </Border>

                                            <!-- Happy Arc Eye (Chevrons) -->
                                            <Path x:Name="RightEyeHappy" 
                                                  Data="M 1 11 Q 6.5 3 12 11" 
                                                  Stroke="#00F2FE" 
                                                  StrokeThickness="2.8" 
                                                  StrokeStartLineCap="Round" 
                                                  StrokeEndLineCap="Round" 
                                                  Visibility="Collapsed">
                                                <Path.Effect>
                                                    <DropShadowEffect Color="#00F2FE" BlurRadius="8" ShadowDepth="0" Opacity="0.95"/>
                                                </Path.Effect>
                                            </Path>

                                            <!-- Sleeping Flat Eye -->
                                            <Rectangle x:Name="RightEyeSleeping" 
                                                       Width="9.5" Height="3" 
                                                       RadiusX="1.5" RadiusY="1.5" 
                                                       Fill="#0284C7" 
                                                       Visibility="Collapsed"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Border>
                </Grid>
            </Canvas>
        </Viewbox>
    </Grid>
</UserControl>

