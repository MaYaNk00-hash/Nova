<Window x:Class="Nova.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="NOVA" 
        Height="360" 
        Width="520"
        WindowStartupLocation="CenterScreen"
        Background="#0F1117"
        Foreground="#E0E6ED">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="NOVA" 
                       FontSize="28" 
                       FontWeight="Bold" 
                       Foreground="#64D2FF"/>
            <TextBlock Text="Desktop Companion" 
                       FontSize="13" 
                       Foreground="#8E9AA8" 
                       Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Status Card -->
        <Border Grid.Row="1" 
                Background="#181B24" 
                BorderBrush="#2A2F3D" 
                BorderThickness="1" 
                CornerRadius="8" 
                Margin="0,20,0,20" 
                Padding="16">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Phase 0: Environment &amp; Project Foundation" 
                           FontSize="15" 
                           FontWeight="SemiBold" 
                           Foreground="#FFFFFF" 
                           Margin="0,0,0,10"/>
                <TextBlock Text="• Target Framework: .NET 8.0 (Windows)" 
                           FontSize="12" 
                           Foreground="#A0AEC0" 
                           Margin="0,2"/>
                <TextBlock Text="• Architecture: x64" 
                           FontSize="12" 
                           Foreground="#A0AEC0" 
                           Margin="0,2"/>
                <TextBlock Text="• UI Technology: WPF / XAML" 
                           FontSize="12" 
                           Foreground="#A0AEC0" 
                           Margin="0,2"/>
                <TextBlock Text="• Status: Ready for Phase 1 (Dynamic Island)" 
                           FontSize="12" 
                           Foreground="#30D158" 
                           FontWeight="Medium" 
                           Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <TextBlock Grid.Row="2" 
                   Text="Version 0.1.0 • Standalone Windows Companion" 
                   FontSize="11" 
                   Foreground="#5A6472" 
                   HorizontalAlignment="Center"/>
    </Grid>
</Window>
